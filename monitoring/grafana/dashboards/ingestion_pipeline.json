    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 9,
      "title": "Worker Processing Latency Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(worker_processing_duration_seconds_bucket[30s])) by (le)) * 1000",
          "legendFormat": "Worker p95 (ms)"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(worker_processing_duration_seconds_bucket[30s])) by (le)) * 1000",
          "legendFormat": "Worker p50 (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    }
